#
# /etc/systemd/system/samplicator.service
#
# a startup file for samplicator. See INSTALL.md
#
# based on systemd file from 
# 5.1.2017, Ch. Bueche <bueche@netnea.com>
# 

[Unit]
Description=Control the launch of several samplicator process 
After=network.target

[Service]
#ExecReload=/bin/kill -HUP $MAINPID
#KillMode=process (sugerido por chatgpt)
KillMode=control-group
Restart=on-failure
RestartSec=42s
Type=forking
# (sugerido por un wait en el exec de samplictorctl ) 
#Type=simple
ExecStart=/usr/sbin/samplicatorctl start
ExecReload=/usr/sbin/samplicatorctl reload
ExecStop=/usr/sbin/samplicatorctl stop


[Install]
WantedBy=multi-user.target

